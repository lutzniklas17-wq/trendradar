# Supabase (Project Settings -> API). Die URL und der Anon-Key dürfen im Browser landen; Daten schützt Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Einzige E-Mail-Adresse, die sich anmelden darf
ALLOWED_EMAIL=

# Google Trends (siehe README), nur serverseitig. API-Login und API-Passwort aus dem DataForSEO-Dashboard.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_DAILY_LIMIT=30

# Meta Ad Library API (siehe README), nur serverseitig. Langlebiges User Access Token, läuft nach rund 60 Tagen ab.
META_ACCESS_TOKEN=
# META_GRAPH_VERSION=v26.0

# Täglicher Lauf (Shop Spy, siehe README). Nur serverseitig, niemals mit NEXT_PUBLIC_ beginnen.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# --- Später (nur serverseitig) ---
# CJ_API_KEY=
# ANTHROPIC_API_KEY=

# Product Hunt API v2: Developer Token (optional, kostenlos, nur nicht kommerziell)
PRODUCTHUNT_TOKEN=

# Produkt-Bibliothek: CJdropshipping API (kostenloses CJ-Konto, API-Key unter „Authorization“)
CJ_API_KEY=
# Max. CJ-Abfragen pro Tag (Standard 300, CJ erlaubt kostenlosen Konten 1000)
CJ_DAILY_LIMIT=

# KI-Bewertung (Claude Haiku). Ohne Key bleibt die KI aus.
ANTHROPIC_API_KEY=
# Monatsbudget in USD (Standard 5), wird gleichmässig auf die Tage verteilt
AI_MONTHLY_BUDGET_USD=
