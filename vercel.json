{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/collect?job=ads",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/collect?job=startups",
      "schedule": "40 3 * * *"
    },
    {
      "path": "/api/cron/collect?job=producthunt",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/collect?job=rss",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/cron/collect?job=news",
      "schedule": "45 4 * * *"
    },
    {
      "path": "/api/cron/shops",
      "schedule": "0 5 * * *"
    }
  ]
}
